{
"name": "duty-calculator",
"version": "1.0.6",
"description": "Duty Attendance Calculator",
"main": "main.js",
"scripts": {
"start": "electron .",
"build": "electron-builder"
},
"build": {
"appId": "com.duty.calculator",
"productName": "DutyCalculator",
"electronVersion": "33.2.1",
"win": {
"target": "nsis",
"icon": "image.ico"
},
"nsis": {
"oneClick": false,
"perMachine": false,
"allowToChangeInstallationDirectory": true,
"createDesktopShortcut": "always",
"createStartMenuShortcut": true,
"shortcutName": "Duty Calculator"
},
"directories": {
"output": "dist"
},
"publish": {
"provider": "github",
"owner": "imtaen",
"repo": "duty-calculator"
}
},
"devDependencies": {
"electron": "33.2.1",
"electron-builder": "^26.18.0"
},
"dependencies": {
"electron-updater": "^6.8.11"
}
}
